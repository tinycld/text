node_modules/
*.tsbuildinfo
.DS_Store
pnpm-lock.yaml
# Per-developer Claude Code workspace (session worktrees, scratch files).
.claude/
# Playwright test output (traces, screenshots, videos).
test-results/

# Auto-generated WebView editor bundle. Produced by
# tinycld/text/webview-editor/build.ts on every dev start and CI build
# via scripts/generate-packages.ts in the app shell. The file is large
# (~800 KB minified) and changes on every esbuild run, so keeping it
# tracked would churn git history for no benefit.
tinycld/text/webview-editor/build/

# Per-member Go workspace (generated by the app shell; resolves tinycld.org/core
# for standalone go build/test in this dir). Never committed — the assembled
# build uses app/server/go.work instead.
/server/go.work
/server/go.work.sum
# Same for the cli module's workspace (resolves tinycld.org/cli).
/cli/go.work
/cli/go.work.sum
