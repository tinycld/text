{
    "extends": "@tinycld/core/tsconfig.package-base.json",
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "~/tinycld/text/*": ["./tinycld/text/*"]
        }
    },
    "include": ["tinycld/**/*.ts", "tinycld/**/*.tsx"],
    "exclude": [
        "node_modules",
        "server",
        "pb-migrations",
        "tests/**/*.spec.ts",
        "tinycld/text/webview-editor/source"
    ]
}
